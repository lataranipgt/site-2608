---
import imageLeaves from "../assets/abstract/leaves-1.png";
---

<div class="separator" style={`--image-leaves: url(${imageLeaves.src})`}>
  <hr>
  <span class="middle"></span>
  <hr>
</div>

<style>
  .separator {
    /* border: 2px dotted; */
    display: flex;
    align-items: center;
    justify-content: space-between;
    /* margin: 1rem 0; */
    /* margin-bottom: 2rem; */
    hr {
      /* border: 2px dotted; */
      width: 40%;
      margin: 1rem 0;
    }
    span {
      /* border: 2px dotted; */
      width: 1rem;
      height: 1rem;
      margin: 0 1rem;
      background-image: var(--image-leaves);
      background-repeat: no-repeat;
      background-size: 100% 100%;
    }
  }
</style>
