---
/** Decorative horizontal separator with optimized leaves artwork. */
import { Image } from "astro:assets";
import imageLeaves from "../assets/abstract/leaves-1.png";
---

<div class="separator">
  <hr>
  <Image
    alt=""
    aria-hidden="true"
    class="middle"
    height={16}
    layout="constrained"
    loading="lazy"
    src={imageLeaves}
    width={16}
  />
  <hr>
</div>

<style>
  .separator {
    /* border: 2px dotted; */
    display: flex;
    align-items: center;
    justify-content: space-between;
    /* margin: 1rem 0; */
    /* margin-bottom: 2rem; */
    hr {
      /* border: 2px dotted; */
      width: 40%;
      margin: 1rem 0;
    }
    .middle {
      /* border: 2px dotted; */
      width: 1rem;
      height: 1rem;
      margin: 0 1rem;
    }
  }
</style>
